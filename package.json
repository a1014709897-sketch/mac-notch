{
  "name": "mac-notch",
  "productName": "Mac Notch",
  "version": "0.2.10",
  "description": "macOS notch companion and menu bar subscription quotas for Claude, Codex and WorkBuddy",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": "Mac Notch contributors",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "smoke": "electron . --smoke",
    "site:build": "node scripts/site.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "pack": "npm run native:arm64 && electron-builder --mac --arm64 --dir --publish never && node scripts/verify-mac.js arm64",
    "dist": "npm run native:arm64 && electron-builder --mac --arm64 --publish never && node scripts/verify-mac.js arm64",
    "dist:x64": "npm run native:x64 && electron-builder --mac --x64 --publish never && node scripts/verify-mac.js x64",
    "source": "node scripts/source.js",
    "checksums": "node scripts/checksums.js",
    "release:local": "npm run verify && npm run dist && npm run source && npm run checksums",
    "native:arm64": "npm install --cpu=arm64 --os=darwin --ignore-scripts --no-save --package-lock=false",
    "native:x64": "npm install --cpu=x64 --os=darwin --ignore-scripts --no-save --package-lock=false"
  },
  "dependencies": {
    "koffi": "3.3.5"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "io.github.a1014709897-sketch.macnotch",
    "productName": "Mac Notch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "assets/app.icns"
    },
    "artifactName": "Mac-Notch-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a1014709897-sketch/mac-notch.git"
  },
  "homepage": "https://a1014709897-sketch.github.io/mac-notch/",
  "bugs": {
    "url": "https://github.com/a1014709897-sketch/mac-notch/issues"
  }
}
